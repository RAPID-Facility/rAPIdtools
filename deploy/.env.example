# Copy to deploy/.env and fill in. Never commit the filled-in file.

# DNS name of the server; Caddy issues the HTTPS certificate for it.
RAPIDTOOLS_DOMAIN=gui.example.edu

# Shared access token colleagues must present (share link: https://<domain>/?token=<value>).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(18))"
RAPIDTOOLS_GUI_TOKEN=change-me

# Host folders mounted into the container: imagery colleagues may load, and results.
DATA_DIR=/srv/rapidtools/data
OUTPUT_DIR=/srv/rapidtools/output

# Email notifications (optional; webhooks need nothing). Password stays here, never on the command line.
RAPIDTOOLS_SMTP_HOST=
RAPIDTOOLS_SMTP_PORT=587
RAPIDTOOLS_SMTP_USER=
RAPIDTOOLS_SMTP_PASSWORD=
RAPIDTOOLS_SMTP_FROM=
RAPIDTOOLS_SMTP_SSL=0

# CPU-only build (no GPU on the machine): uncomment both.
#BASE_IMAGE=python:3.11-slim
#TORCH_INDEX=https://download.pytorch.org/whl/cpu
