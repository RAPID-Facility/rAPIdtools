# Keep the Docker build context to the package sources.
.git
.gitignore
docs/build
examples/*.tif
examples/*.tiff
examples/*.aux.xml
examples/*.geojson
examples/output
examples/eaton_fire_aerial_feb25
asset_analysis_output
out
*.png
*.jpg
*.html
!rapidtools/gui/static/index.html
*.geojson
build
dist
htmlcov
.coverage
.pytest_cache
.ruff_cache
.mypy_cache
.claude
.vscode
.idea
venv
.conda

# A pattern without a slash only matches at the top of the context, so the
# folders that appear at any depth need the ** prefix.
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.ipynb_checkpoints

# Credentials git already ignores: example API keys and tokens, and the
# filled-in deployment settings. They must never be copied into an image.
examples/api_key.txt
examples/*token*.txt
**/.env
**/*.env
