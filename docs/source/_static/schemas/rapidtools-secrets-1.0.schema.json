{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rapidtools:schema:secrets:1.0",
  "title": "rapidtools secrets file",
  "description": "Credentials referenced by a job file as {\"$secret\": name}.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "secrets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "rapidtools.secrets"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
